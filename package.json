{
  "name": "extension-factory",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A factory for small, private, rules-driven Chrome extensions.",
  "scripts": {
    "lint": "eslint .",
    "test:unit": "playwright test --project=unit",
    "test:e2e": "playwright test --project=e2e",
    "test": "playwright test",
    "icons": "node scripts/icons.mjs",
    "build": "node scripts/build.mjs",
    "release": "node scripts/build.mjs --release --e2e",
    "rules:key": "node scripts/rules-key.mjs",
    "store": "node scripts/store.mjs",
    "rules:publish": "node scripts/publish-rules.mjs",
    "rules:check": "node scripts/check-remote-rules.mjs",
    "cws": "node scripts/cws.mjs",
    "cws:status": "node scripts/cws.mjs status",
    "cws:upload": "node scripts/cws.mjs upload",
    "cws:publish": "node scripts/cws.mjs publish",
    "stripe:setup": "node scripts/stripe-setup.mjs",
    "release:ship": "node scripts/ship.mjs",
    "finder": "node tools/finder/finder.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "fflate": "^0.8.3",
    "globals": "^17.13.0"
  }
}
